# Copy to a private shell file outside Git, edit paths, then source it.
export CAARMA_REPO=/jet/home/sge2/CAARMA
export CAARMA_DATA_ROOT=/ocean/projects/cis220031p/shared/raw/data
export CAARMA_VOX1_ROOT="$CAARMA_DATA_ROOT/VoxCeleb1"
export CAARMA_VOX2_ROOT="$CAARMA_DATA_ROOT/VoxCeleb2"

# Set these after audit_voxceleb.slurm reveals the actual layout.
export CAARMA_VOX1_TRAIN_ROOT=/replace/with/vox1/training/audio/root
export CAARMA_VOX2_TRAIN_ROOT=/replace/with/vox2/training/audio/root
export CAARMA_VOX1_EVAL_ROOT=/replace/with/vox1/test/audio/root
export CAARMA_TRIAL_PATH=/replace/with/veri_test2.txt

export CAARMA_RUN_ROOT=/ocean/projects/cis220031p/sge2/caarma_runs
export CAARMA_TRAIN_MANIFEST="$CAARMA_RUN_ROOT/manifests/vox1_train.csv"
export CAARMA_HUBERT_CACHE=/ocean/projects/cis220031p/sge2/huggingface
export CAARMA_CONDA_ENV=/ocean/projects/cis220031p/sge2/conda_envs/caarma
# Alternatively: export CAARMA_VENV=/ocean/projects/cis220031p/sge2/venvs/caarma
